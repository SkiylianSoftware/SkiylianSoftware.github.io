---
layout: compress
permalink: /feed.xml
# Atom Feed, reference: https://validator.w3.org/feed/docs/atom.html
# Site override of the Chirpy theme's assets/feed.xml. Differences:
#   - Configurable entry limit via site.feed.posts_limit (default 50) instead of 5.
#   - Properly XML-escapes every dynamic value (titles with '&' used to produce
#     invalid XML) instead of the theme's blanket replace:'&','&amp;' trick,
#     which double-escapes values that are already escaped.
#   - Emits a media:thumbnail from each post's image so feed readers and link
#     preview bots show a video thumbnail.
---

{% capture source %}
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{ "/" | absolute_url }}</id>
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.social.name }}</name>
    <uri>{{ "/" | absolute_url }}</uri>
  </author>
  <link rel="self" type="application/atom+xml" href="{{ page.url | absolute_url }}"/>
  <link rel="alternate" type="text/html" hreflang="{{ site.alt_lang | default: site.lang }}"
    href="{{ '/' | absolute_url }}"/>
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <rights> &#169; {{ 'now' | date: '%Y' }} {{ site.social.name }} </rights>
  <icon>{{ site.baseurl }}/assets/img/favicons/favicon.ico</icon>
  <logo>{{ site.baseurl }}/assets/img/favicons/favicon-96x96.png</logo>

{% assign posts_limit = site.feed.posts_limit | default: 50 %}
{% for post in site.posts limit: posts_limit %}
  {% assign post_absolute_url = post.url | absolute_url %}
  <entry>
    <title type="text">{{ post.title | xml_escape }}</title>
    <link href="{{ post_absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <id>{{ post_absolute_url }}</id>
    <content type="text/html" src="{{ post_absolute_url }}" />
    <author>
      <name>{{ post.author | default: site.social.name | xml_escape }}</name>
    </author>

  {% if post.categories %}
    {% for category in post.categories %}
    <category term="{{ category | xml_escape }}" />
    {% endfor %}
  {% endif %}
  {% for tag in post.tags %}
    <category term="{{ tag | xml_escape }}" />
  {% endfor %}

  {% assign post_image = post.image.path | default: post.image %}
  {% if post_image %}
    {% unless post_image contains "://" %}
      {% assign post_image = post_image | absolute_url %}
    {% endunless %}
    <media:thumbnail xmlns:media="http://search.yahoo.com/mrss/" url="{{ post_image | xml_escape }}" />
  {% endif %}

  <summary>{% capture post_summary %}{% include post-summary.html max_length=400 %}{% endcapture %}{{ post_summary | strip | xml_escape }}</summary>

  </entry>
{% endfor %}
</feed>
{% endcapture %}
{{ source }}